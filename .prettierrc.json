{
    "tabWidth": 2,
    "useTabs": false,
    "singleQuote": true,
    "semi": true,
    "bracketSpacing": true,
    "arrowParens": "avoid",
    "trailingComma": "es5",
    "printWidth": 140,
    "bracketSameLine": false,
    "overrides": [
        {
            "files": "*.html",
            "options": {
                "parser": "angular",
                "bracketSameLine": false
            }
        }
    ]
}